datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  phone        String
  email        String   @unique
  address      String?
  gstNumber    String?
  currency     String   @default("INR")
  businessType String   @default("HYBRID") // TAILOR_SHOP, GARMENT_FACTORY, HYBRID
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branches             Branch[]
  users                User[]
  customers            Customer[]
  measurementTemplates MeasurementTemplate[]
  customerMeasurements CustomerMeasurement[]
  productStyles        ProductStyle[]
  bomItems             BOMItem[]
  inventoryItems       InventoryItem[]
  stockMovements       StockMovement[]
  orders               Order[]
  orderItems           OrderItem[]
  jobCards             ProductionJobCard[]
  productionLogs       ProductionLog[]
  qcRecords            QCRecord[]
  workers              Worker[]
  pieceRateLogs        PieceRateLog[]
  invoices             Invoice[]
  payments             Payment[]
  suppliers            Supplier[]
  purchaseOrders       PurchaseOrder[]
  shipments            Shipment[]
  whatsAppConfig       WhatsAppConfig?
  whatsAppMessages     WhatsAppMessageLog[]
  whatsAppTemplates    WhatsAppTemplate[]
  googleIntegration    GoogleIntegration?
  auditLogs            AuditLog[]
  productionOrders     ProductionOrder[]
  materialRequirements MaterialRequirement[]
  purchaseRequirements PurchaseRequirement[]
  fabricRolls          FabricRoll[]
  cuttingPlans         CuttingPlan[]
  bundles              Bundle[]
  productionLines      ProductionLine[]
  dailyProductions     DailyProduction[]
  reworkEntries        ReworkEntry[]
  finishedGoods        FinishedGoods[]
  manufacturingCostings ManufacturingCosting[]
}

model Branch {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  code      String
  phone     String?
  address   String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  orders         Order[]
  jobCards       ProductionJobCard[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  workers        Worker[]
  pieceRateLogs  PieceRateLog[]
  invoices       Invoice[]
  payments       Payment[]
  purchaseOrders PurchaseOrder[]
  shipments      Shipment[]
  productionOrders ProductionOrder[]
  productionLines  ProductionLine[]
  finishedGoods    FinishedGoods[]

  @@unique([companyId, code])
}

model User {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name         String
  email        String
  phone        String
  passwordHash String
  role         String   @default("MANAGER") // OWNER, ADMIN, MANAGER, SALES, TAILOR, CUTTER, PRODUCTION_MANAGER, QC, STORE_MANAGER, ACCOUNTANT
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ordersCreated           Order[]
  qcRecords               QCRecord[]
  payments                Payment[]
  auditLogs               AuditLog[]
  productionOrdersManaged ProductionOrder[]

  @@unique([companyId, email])
  @@unique([companyId, phone])
}

model Customer {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  businessName String?
  phone        String
  whatsapp     String?
  email        String?
  address      String?
  gstNumber    String?
  customerType String   @default("INDIVIDUAL") // INDIVIDUAL, TAILOR_CUSTOMER, BOUTIQUE, BRAND, WHOLESALE
  notes        String?
  tags         String   @default("[]") // JSON string array
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  measurements CustomerMeasurement[]
  orders       Order[]
  payments     Payment[]
  productionOrders ProductionOrder[]
}

model MeasurementTemplate {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String   // e.g. "Men's Shirt", "Kurti", "Trouser"
  gender      String   @default("MEN") // MEN, WOMEN, KIDS, UNISEX
  category    String   // Tops, Bottoms, Suits, Ethnic
  fieldsJson  String   // JSON string of field definitions: [{"key": "chest", "label": "Chest", "unit": "inch"}]
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customerMeasurements CustomerMeasurement[]
}

model CustomerMeasurement {
  id                  String               @id @default(uuid())
  companyId           String
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  templateId          String?
  template            MeasurementTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title               String               // e.g. "Formal Shirt Measurement"
  gender              String               @default("MEN")
  unit                String               @default("INCH") // INCH, CM
  valuesJson          String               // JSON string of key-value pairs: {"chest": 40, "waist": 34}
  specialInstructions String?
  referenceImagesJson String               @default("[]") // JSON array of image URLs
  version             Int                  @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  orderItems OrderItem[]
}

model ProductStyle {
  id                  String   @id @default(uuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  styleNumber         String
  name                String
  category            String
  description         String?
  photoUrl            String?
  fabricDetails       String?
  brand               String?
  gender              String   @default("MEN")
  sizeRangeJson       String   @default("[]") // e.g. ["S", "M", "L", "XL"]
  colorRangeJson      String   @default("[]") // e.g. ["White", "Navy Blue", "Black"]
  sellingPrice        Float    @default(0)
  estimatedCost       Float    @default(0)
  standardProdMinutes Int      @default(60)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  bomItems   BOMItem[]
  orderItems OrderItem[]
  productionOrders ProductionOrder[]
  manufacturingCostings ManufacturingCosting[]

  @@unique([companyId, styleNumber])
}

model BOMItem {
  id                String        @id @default(uuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productStyleId    String
  productStyle      ProductStyle  @relation(fields: [productStyleId], references: [id], onDelete: Cascade)
  inventoryItemId   String?
  inventoryItem     InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  materialName      String
  quantity          Float
  unit              String        // meter, pcs, meters, grams
  wastagePercentage Float         @default(0)
  costPerUnit       Float         @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model InventoryItem {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name          String
  sku           String?
  category      String   // FABRIC, BUTTON, ZIPPER, THREAD, LINING, LABEL, PACKING_MATERIAL, ACCESSORY
  unit          String   // meter, pcs, roll, box
  currentStock  Float    @default(0)
  minStockAlert Float    @default(10)
  unitCost      Float    @default(0)
  supplierName  String?
  location      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bomItems             BOMItem[]
  stockMovements       StockMovement[]
  materialRequirements MaterialRequirement[]
  purchaseRequirements PurchaseRequirement[]
}

model StockMovement {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  movementType    String        // PURCHASE_IN, PRODUCTION_CONSUMPTION, DAMAGE_WASTAGE, RETURN, ADJUSTMENT
  quantity        Float
  unitCost        Float         @default(0)
  referenceType   String?       // ORDER, JOB_CARD, PO
  referenceId     String?
  notes           String?
  performedById   String?
  createdAt       DateTime      @default(now())
}

model Order {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderNumber   String
  orderType     String   @default("BESPOKE_TAILORING") // BESPOKE_TAILORING, BULK_MANUFACTURING, ALTERATION, SAMPLE
  status        String   @default("CONFIRMED")
  priority      String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  trialDate     DateTime?
  deliveryDate  DateTime
  totalAmount   Float    @default(0)
  discount      Float    @default(0)
  taxRate       Float    @default(0)
  taxAmount     Float    @default(0)
  finalAmount   Float    @default(0)
  advancePaid   Float    @default(0)
  balanceDue    Float    @default(0)
  paymentStatus String   @default("PENDING") // PENDING, PARTIAL, PAID
  notes         String?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items    OrderItem[]
  jobCards ProductionJobCard[]
  invoices Invoice[]
  payments Payment[]
  shipments Shipment[]
  whatsAppMessages WhatsAppMessageLog[]
  productionOrders ProductionOrder[]

  @@unique([companyId, orderNumber])
}

model OrderItem {
  id                       String               @id @default(uuid())
  companyId                String
  company                  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId                  String
  order                    Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productStyleId           String?
  productStyle             ProductStyle?        @relation(fields: [productStyleId], references: [id], onDelete: SetNull)
  measurementId            String?
  measurement              CustomerMeasurement? @relation(fields: [measurementId], references: [id], onDelete: SetNull)
  customItemName           String
  itemType                 String               @default("BESPOKE_TAILORING")
  gender                   String               @default("MEN")
  quantity                 Int                  @default(1)
  unitPrice                Float                @default(0)
  totalAmount              Float                @default(0)
  fabricProvidedByCustomer Boolean              @default(false)
  fabricDetails            String?
  color                    String?
  size                     String?
  designNotes              String?
  referenceImagesJson      String               @default("[]")
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  jobCards ProductionJobCard[]
}

model ProductionJobCard {
  id                String     @id @default(uuid())
  companyId         String
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId       String
  orderItem         OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  jobCardNumber     String
  currentStage      String     @default("CUTTING") // CUTTING, STITCHING, FINISHING, QC_INSPECTION, IRONING_PACKING, COMPLETED
  qcStatus          String     @default("PENDING") // PENDING, PASSED, REWORK_REQUIRED, REJECTED
  qrCode            String
  priority          String     @default("NORMAL")
  assignedWorkerId  String?
  assignedWorker    Worker?    @relation(fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  plannedQuantity   Int        @default(1)
  completedQuantity Int        @default(0)
  rejectedQuantity  Int        @default(0)
  startedAt         DateTime   @default(now())
  completedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  productionLogs ProductionLog[]
  qcRecords      QCRecord[]
  pieceRateLogs  PieceRateLog[]

  @@unique([companyId, jobCardNumber])
}

model ProductionLog {
  id        String            @id @default(uuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobCardId String
  jobCard   ProductionJobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  stage     String
  workerId  String?
  worker    Worker?           @relation(fields: [workerId], references: [id], onDelete: SetNull)
  quantity  Int               @default(1)
  notes     String?
  createdAt DateTime          @default(now())
}

model QCRecord {
  id                 String             @id @default(uuid())
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobCardId          String?
  jobCard            ProductionJobCard? @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  stage              String             @default("STITCHING")
  inspectedQuantity  Int                @default(1)
  passedQuantity     Int                @default(1)
  reworkQuantity     Int                @default(0)
  rejectedQuantity   Int                @default(0)
  inspectorId        String?
  inspector          User?              @relation(fields: [inspectorId], references: [id], onDelete: SetNull)
  status             String             // PASSED, REWORK_REQUIRED, REJECTED
  defectType         String?            // STITCHING_DEFECT, MEASUREMENT_MISMATCH, etc.
  defectNotes        String?
  defectPhotosJson   String             @default("[]")
  reworkAssignedToId String?
  createdAt          DateTime           @default(now())
}

model Worker {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name             String
  phone            String
  email            String?
  role             String   @default("TAILOR") // TAILOR, CUTTER, MASTER, FINISHER, QC_OPERATOR
  wageType         String   @default("PIECE_RATE") // PIECE_RATE, MONTHLY_SALARY, DAILY_WAGE
  defaultPieceRate Float    @default(0)
  monthlySalary    Float    @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  jobCards                   ProductionJobCard[]
  productionLogs             ProductionLog[]
  pieceRateLogs              PieceRateLog[]
  cuttingPlans               CuttingPlan[]
  productionLinesSupervised  ProductionLine[]
  dailyProductions           DailyProduction[]
  reworkAssigned             ReworkEntry[]
}

model PieceRateLog {
  id           String             @id @default(uuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  workerId     String
  worker       Worker             @relation(fields: [workerId], references: [id], onDelete: Cascade)
  jobCardId    String?
  jobCard      ProductionJobCard? @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  stage        String             // CUTTING, STITCHING, FINISHING
  quantity     Int                @default(1)
  ratePerPiece Float              @default(0)
  totalPayout  Float              @default(0)
  isPaid       Boolean            @default(false)
  notes        String?
  createdAt    DateTime           @default(now())
}

model Invoice {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber   String
  customerName    String
  customerPhone   String
  customerAddress String?
  customerGst     String?
  subtotal        Float     @default(0)
  discount        Float     @default(0)
  taxRate         Float     @default(0)
  taxAmount       Float     @default(0)
  totalAmount     Float     @default(0)
  amountPaid      Float     @default(0)
  balanceDue      Float     @default(0)
  invoiceDate     DateTime  @default(now())
  dueDate         DateTime?
  pdfUrl          String?
  status          String    @default("PENDING") // PENDING, PARTIAL, PAID
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  payments Payment[]
  whatsAppMessages WhatsAppMessageLog[]

  @@unique([companyId, invoiceNumber])
}

model Payment {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount          Float
  paymentMethod   String   @default("CASH") // CASH, UPI, CREDIT_CARD, DEBIT_CARD, BANK_TRANSFER, RAZORPAY
  referenceNumber String?
  notes           String?
  recordedById    String?
  recordedBy      User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  whatsAppMessages WhatsAppMessageLog[]
}

model Supplier {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  companyName  String?
  phone        String
  email        String?
  address      String?
  gstNumber    String?
  paymentTerms String?  @default("Net 30")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  poNumber      String
  status        String   @default("ORDERED") // DRAFT, ORDERED, RECEIVED, CANCELLED
  totalAmount   Float    @default(0)
  taxAmount     Float    @default(0)
  finalAmount   Float    @default(0)
  paymentStatus String   @default("PENDING") // PENDING, PARTIAL, PAID
  orderDate     DateTime @default(now())
  expectedDate  DateTime?
  receivedDate  DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items PurchaseOrderItem[]
  purchaseRequirements PurchaseRequirement[]

  @@unique([companyId, poNumber])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  companyId       String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialName    String
  quantity        Float
  unit            String
  unitCost        Float         @default(0)
  totalAmount     Float         @default(0)
  createdAt       DateTime      @default(now())
}

model Shipment {
  id               String    @id @default(uuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingNumber   String?
  courierName      String?   // e.g. BlueDart, Delhivery, Porter, Self-Delivery
  status           String    @default("PENDING") // PENDING, PACKED, DISPATCHED, IN_TRANSIT, DELIVERED, CANCELLED
  packageWeightKg  Float?
  boxDimensions    String?   // e.g. "30x20x15 cm"
  dispatchDate     DateTime?
  expectedDelivery DateTime?
  deliveredDate    DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model WhatsAppConfig {
  id                 String   @id @default(uuid())
  companyId          String   @unique
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerWhatsApp      String?
  phoneNumberId      String?
  businessAccountId  String?
  apiToken           String?
  webhookSecret      String?
  providerType       String   @default("FALLBACK_LINK") // CLOUD_API, ON_PREMISE, FALLBACK_LINK
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WhatsAppMessageLog {
  id                String    @id @default(uuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipientPhone    String
  recipientName     String?
  messageType       String    // ORDER_CONFIRM, INVOICE, PAYMENT_RECEIPT, ORDER_READY, DELIVERY_REMINDER, DISPATCH, THANK_YOU, CUSTOM
  templateName      String?
  messageText       String
  status            String    @default("SENT") // NOT_SENT, SENDING, SENT, DELIVERED, READ, FAILED
  provider          String    @default("WHATSAPP_WEB_LINK") // WHATSAPP_BUSINESS_API, WHATSAPP_WEB_LINK, SHARE_FALLBACK
  externalMessageId String?
  failureReason     String?
  orderId           String?
  order             Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoiceId         String?
  invoice           Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentId         String?
  payment           Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  customerId        String?
  createdAt         DateTime  @default(now())
}

model WhatsAppTemplate {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  category      String   // ORDER_CONFIRM, INVOICE, PAYMENT_RECEIPT, ORDER_READY, DELIVERY_REMINDER, DISPATCH, THANK_YOU
  bodyText      String
  variablesJson String   @default("[]")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GoogleIntegration {
  id              String    @id @default(uuid())
  companyId       String    @unique
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  googleEmail     String?
  accessToken     String?
  refreshToken    String?
  tokenExpiry     DateTime?
  spreadsheetId   String?
  spreadsheetUrl  String?
  lastSyncAt      DateTime?
  syncStatus      String?   // IDLE, SYNCING, SUCCESS, FAILED
  syncDetailsJson String?
  autoSyncEnabled Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // EXCEL_IMPORT, EXCEL_EXPORT, GOOGLE_IMPORT, GOOGLE_EXPORT, GOOGLE_SYNC, WHATSAPP_SENT, INVOICE_SENT, PAYMENT_RECEIPT_SENT, TEMPLATE_DOWNLOAD
  entityType  String   // PRODUCT, CUSTOMER, INVENTORY, ORDER, INVOICE, PAYMENT, TEMPLATE, SETTINGS
  recordId    String?
  status      String   // SUCCESS, FAILED, WARNING
  detailsJson String?  // Stores counts, error details, filters, query info
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model ProductionOrder {
  id                    String   @id @default(uuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId              String?
  branch                Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orderId               String?
  order                 Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  productStyleId        String?
  productStyle          ProductStyle? @relation(fields: [productStyleId], references: [id], onDelete: SetNull)
  buyerId               String?
  buyer                 Customer? @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  productionOrderNumber String
  styleNumber           String
  productName           String
  totalQuantity         Int
  sizeBreakdownJson     String   @default("{}") // e.g. {"S": 100, "M": 200, "L": 300, "XL": 250, "XXL": 100}
  colorBreakdownJson    String   @default("{}") // e.g. {"White": 950, "Blue": 800, "Black": 680}
  matrixJson            String   @default("{}") // Size x Color nested matrix
  plannedStartDate      DateTime @default(now())
  plannedCompletionDate DateTime
  actualStartDate       DateTime?
  actualCompletionDate  DateTime?
  priority              String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  productionUnit        String?  @default("Main Production Unit")
  assignedManagerId     String?
  assignedManager       User?    @relation(fields: [assignedManagerId], references: [id], onDelete: SetNull)
  status                String   @default("PLANNED") // PLANNED, MATERIAL_PENDING, READY_FOR_CUTTING, CUTTING, STITCHING, FINISHING, QC, PACKING, COMPLETED, CANCELLED
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  materialRequirements MaterialRequirement[]
  purchaseRequirements PurchaseRequirement[]
  cuttingPlans         CuttingPlan[]
  bundles              Bundle[]
  dailyProductions     DailyProduction[]
  reworkEntries        ReworkEntry[]
  finishedGoods        FinishedGoods[]
  manufacturingCosting ManufacturingCosting?

  @@unique([companyId, productionOrderNumber])
}

model MaterialRequirement {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  inventoryItemId   String?
  inventoryItem     InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  materialName      String
  category          String          // FABRIC, BUTTON, ZIPPER, THREAD, LINING, LABEL, PACKING_MATERIAL, ACCESSORY
  unit              String          // meter, pcs, kg, roll
  bomPerGarment     Float
  grossRequired     Float
  wastagePercentage Float           @default(5.0)
  currentStock      Float           @default(0)
  availableStock    Float           @default(0)
  shortageQuantity  Float           @default(0)
  purchaseRequired  Boolean         @default(false)
  status            String          @default("AVAILABLE") // AVAILABLE, PARTIALLY_AVAILABLE, OUT_OF_STOCK
  createdAt         DateTime        @default(now())
}

model PurchaseRequirement {
  id                 String           @id @default(uuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId  String?
  productionOrder    ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  inventoryItemId    String?
  inventoryItem      InventoryItem?   @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  materialName       String
  requiredQuantity   Float
  unit               String
  estimatedUnitCost  Float            @default(0)
  estimatedTotalCost Float            @default(0)
  status             String           @default("PENDING") // PENDING, PO_CREATED, RECEIVED, CANCELLED
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model FabricRoll {
  id                  String        @id @default(uuid())
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rollNumber          String        // e.g. ROLL-2026-081
  fabricType          String        // Cotton, Wool, Linen, Silk, Poly-blend
  color               String
  widthInches         Float         @default(58)
  gsm                 Float         @default(180)
  initialLengthMeters Float
  currentLengthMeters Float
  unitCost            Float         @default(0)
  supplierName        String?
  batchNumber         String?
  warehouseLocation   String?
  status              String        @default("AVAILABLE") // AVAILABLE, IN_USE, CONSUMED, DAMAGED
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  cuttingPlans CuttingPlan[]

  @@unique([companyId, rollNumber])
}

model CuttingPlan {
  id                 String          @id @default(uuid())
  companyId          String
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId  String
  productionOrder    ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  styleNumber        String
  fabricName         String
  fabricRollId       String?
  fabricRoll         FabricRoll?     @relation(fields: [fabricRollId], references: [id], onDelete: SetNull)
  rollLotNumber      String?
  markerLengthMeters Float           @default(0)
  layQuantityPlies   Int             @default(1)
  plannedCutQuantity Int
  actualCutQuantity  Int             @default(0)
  wastageMeters      Float           @default(0)
  cutterId           String?
  cutter             Worker?         @relation(fields: [cutterId], references: [id], onDelete: SetNull)
  cutDate            DateTime        @default(now())
  status             String          @default("IN_PROGRESS") // PLANNED, IN_PROGRESS, COMPLETED
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  bundles Bundle[]
}

model Bundle {
  id                 String          @id @default(uuid())
  companyId          String
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bundleNumber       String          // e.g. BND-1001
  productionOrderId  String
  productionOrder    ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  cuttingPlanId      String?
  cuttingPlan        CuttingPlan?    @relation(fields: [cuttingPlanId], references: [id], onDelete: SetNull)
  styleNumber        String
  size               String
  color              String
  quantity           Int
  cuttingReference   String?
  assignedLineId     String?
  assignedLine       ProductionLine? @relation(fields: [assignedLineId], references: [id], onDelete: SetNull)
  currentStage       String          @default("CUTTING") // CUTTING, STITCHING, FINISHING, QC, PACKING, COMPLETED
  qrCode             String
  barcode            String
  status             String          @default("IN_TRANSIT") // IN_TRANSIT, IN_STITCHING, STITCHED, QC_PASSED, PACKED
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([companyId, bundleNumber])
}

model ProductionLine {
  id                  String   @id @default(uuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId            String?
  branch              Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name                String   // e.g. "Line 1 - Formal Shirts", "Line 2 - Suits"
  code                String
  supervisorId        String?
  supervisor          Worker?  @relation(fields: [supervisorId], references: [id], onDelete: SetNull)
  targetHourlyOutput  Int      @default(20)
  targetDailyOutput   Int      @default(160)
  activeWorkerCount   Int      @default(10)
  status              String   @default("ACTIVE") // ACTIVE, IDLE, MAINTENANCE
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  bundles          Bundle[]
  dailyProductions DailyProduction[]

  @@unique([companyId, code])
}

model DailyProduction {
  id                   String          @id @default(uuid())
  companyId            String
  company              Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId    String
  productionOrder      ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionLineId     String?
  productionLine       ProductionLine? @relation(fields: [productionLineId], references: [id], onDelete: SetNull)
  workerId             String?
  worker               Worker?         @relation(fields: [workerId], references: [id], onDelete: SetNull)
  stage                String          // CUTTING, STITCHING, FINISHING, QC, PACKING
  entryDate            DateTime        @default(now())
  targetQuantity       Int             @default(0)
  completedQuantity    Int             @default(0)
  reworkQuantity       Int             @default(0)
  rejectedQuantity     Int             @default(0)
  efficiencyPercentage Float           @default(100.0) // (completed / target) * 100
  notes                String?
  createdAt            DateTime        @default(now())
}

model ReworkEntry {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  qcRecordId        String?
  bundleId          String?
  defectType        String          // STITCHING_DEFECT, MEASUREMENT_MISMATCH, FABRIC_FLAW, STAIN, BUTTON_LOOSE
  defectNotes       String?
  defectPhotoUrl    String?
  severity          String          @default("MEDIUM") // MINOR, MEDIUM, CRITICAL
  quantity          Int             @default(1)
  assignedWorkerId  String?
  assignedWorker    Worker?         @relation(fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  status            String          @default("PENDING_REWORK") // PENDING_REWORK, REWORK_IN_PROGRESS, RE_INSPECTED_PASS, SCRAPPED
  reworkCost        Float           @default(0)
  createdAt         DateTime        @default(now())
  completedAt       DateTime?
}

model FinishedGoods {
  id                String           @id @default(uuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId          String?
  branch            Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  sku               String
  styleNumber       String
  productName       String
  size              String
  color             String
  batchNumber       String
  quantity          Int
  warehouse         String           @default("Main FG Godown")
  location          String?
  unitCost          Float            @default(0)
  sellingPrice      Float            @default(0)
  packedDate        DateTime         @default(now())
  status            String           @default("IN_STOCK") // IN_STOCK, ALLOCATED, DISPATCHED, RETURNED
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model ManufacturingCosting {
  id                     String          @id @default(uuid())
  companyId              String
  company                Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId      String          @unique
  productionOrder        ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productStyleId         String?
  productStyle           ProductStyle?   @relation(fields: [productStyleId], references: [id], onDelete: SetNull)
  fabricCost             Float           @default(0)
  trimsCost              Float           @default(0)
  labourCost             Float           @default(0)
  embroideryCost         Float           @default(0)
  printingCost           Float           @default(0)
  packingCost            Float           @default(0)
  wastageCost            Float           @default(0)
  overheadCost           Float           @default(0)
  otherCost              Float           @default(0)
  totalActualCost        Float           @default(0)
  estimatedBOMCost       Float           @default(0)
  varianceCost           Float           @default(0) // totalActual - estimatedBOM
  unitActualCost         Float           @default(0)
  unitSellingPrice       Float           @default(0)
  unitProfit             Float           @default(0)
  profitMarginPercentage Float           @default(0)
  costingItemsJson       String?         // JSON array breakdown
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

